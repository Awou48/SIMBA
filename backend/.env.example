# Copy to backend/.env and adjust. Never commit .env.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/simba_db
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8081","http://127.0.0.1:8081"]
# First superadmin, created by `python seed_db.py` when the admins table is empty
FIRST_ADMIN_EMAIL=admin@simba.id
FIRST_ADMIN_PASSWORD=admin1234
FIRST_ADMIN_NAME=SIMBA Admin
