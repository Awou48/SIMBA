# Copy to backend/.env and fill in real values. Never commit .env.

# development | production. "production" refuses the placeholder SECRET_KEY below.
ENVIRONMENT=development

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/simba_db

# Generate one per environment: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-random-64-character-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8081","http://127.0.0.1:8081"]
# Optional, development only: also allow the private-LAN origins a phone running Expo uses.
# CORS_ORIGIN_REGEX=^http://(192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}):(5173|8081)$

# Create missing tables and nullable columns on startup. Set to false in production and use Alembic.
AUTO_SYNC_SCHEMA=true

# First superadmin, created by `python seed_db.py` when the admins table is empty
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=replace-me
FIRST_ADMIN_NAME=SIMBA Admin
